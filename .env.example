OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1
AGENT_BACKEND_HOST=127.0.0.1
AGENT_BACKEND_PORT=3002
AGENT_BACKEND_URL=http://127.0.0.1:3002
AGENT_BACKEND_LOG_LEVEL=INFO
RELOAD=false
APP_TITLE=K Agent API
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Durable state root. Default: ~/.k_agent
# For project-local development use a relative path (resolved against the repo):
# K_AGENT_HOME=.k_agent
#
# Layout:
#   $K_AGENT_HOME/config/          mcp.json, models.json, permissions.json, catalog/
#   $K_AGENT_HOME/state/sessions/  conversation history
#   $K_AGENT_HOME/content/memory/  MEMORY.md
#   $K_AGENT_HOME/content/skills/  Skill packages
#
# On first start, legacy ./data and backend/config/runtime files are copied in
# when the new locations are still empty. Override individual paths only if needed:
# MCP_CONFIG_PATH=
# STORAGE_BASE_DIR=
# SESSION_STORAGE_PREFIX=sessions
# K_AGENT_MEMORY_BASE_DIR=

MCP_CONNECT_TIMEOUT_SECONDS=60
MAX_MODEL_ITERATIONS=6
DEFAULT_SESSION_TITLE=新会话
SESSION_TITLE_MAX_LENGTH=24
STATUS_MODEL_STARTED=模型开始思考
TOOL_ITERATION_LIMIT_MESSAGE=工具调用轮次达到上限，请检查工具链配置。
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TIMEOUT_SECONDS=5
# Optional override. Local builds default to same-origin; Vite development
# defaults to http://localhost:3001.
# VITE_API_BASE_URL=http://localhost:3001
VITE_SESSION_STORAGE_KEY=k-agent-session-id
VITE_CLIENT_PORT=5173
