{
  "name": "k_agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n access,agent,client -c blue,magenta,green \"npm run dev:access\" \"npm run dev:agent\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "npm run dev:access",
    "dev:access": "cd .. && .venv/bin/python -m access_layer.run_server --reload",
    "dev:agent": "cd .. && .venv/bin/python -m backend.run_server --reload",
    "build": "npm run build:client",
    "build:client": "vite build",
    "preview": "vite preview",
    "start": "concurrently -n access,agent -c blue,magenta \"npm run start:access\" \"npm run start:agent\"",
    "deploy:local": "npm run build:client && npm run start",
    "start:access": "cd .. && .venv/bin/python -m access_layer.run_server",
    "start:agent": "cd .. && .venv/bin/python -m backend.run_server",
    "check": "npm run check:boundary && tsc --noEmit",
    "check:boundary": "node scripts/check-boundary.mjs",
    "test:history": "node --import tsx scripts/test-history.ts",
    "test:transcript": "node --import tsx scripts/test-conversation-transcript.ts",
    "test:approval": "node --import tsx scripts/test-live-approval.ts",
    "test:user-question": "node --import tsx scripts/test-user-question.ts",
    "test:run-visibility": "node --import tsx scripts/test-run-visibility.ts",
    "test:stream": "node --import tsx scripts/test-stream-scheduler.ts",
    "test:voice": "node --import tsx scripts/test-voice-interruption.ts"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
