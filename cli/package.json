{
  "name": "@k-agent/cli",
  "version": "0.1.0",
  "description": "K Agent terminal workbench and automation client",
  "type": "module",
  "bin": {
    "k-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/mark-bin-executable.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
